APP_NAME=ANN Retrieval Backend
APP_ENV=dev
API_V1_PREFIX=/api/v1

# Replace this before sharing a deployed instance. Keep at least 32 bytes.
SECRET_KEY=replace-with-a-random-secret-key-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=4320

DATABASE_URL=sqlite:///./ann_system.db

# start.ps1 overrides these to local filesystem/sqlite values so Redis is not
# required for the default Windows demo startup.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

DATA_DIR=../data
INDEX_DIR=../indices
REPORT_DIR=../reports
EXPORT_DIR=../exports

# Optional Doubao/Volcengine Ark API settings for the AI assistant endpoint.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-mini-260428
